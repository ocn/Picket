DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Fixed durable-delivery repair operator; it must remain discord:146451271497416704.
CONTRACT_DELIVERY_OPERATOR_ID=discord:146451271497416704
# SHA-256 digest (exactly 64 hexadecimal characters) of a 64-character raw stdin-only token
# generated from 32 random bytes; stdin is capped at 128 bytes.
CONTRACT_DELIVERY_OPERATOR_TOKEN_SHA256=
# EVE_CLIENT_ID=                      # Existing EVE application; required for /sync_standings and enabled resolver
# EVE_CLIENT_SECRET=                  # Secret application credential; required for /sync_standings and enabled resolver
# STRUCTURE_RESOLVER_ENABLED=false # Enables one dedicated-character structure-location resolver
# STRUCTURE_RESOLVER_CHARACTER_ID= # Dedicated character; never use an ordinary standings authorization
# STRUCTURE_RESOLVER_REFRESH_TOKEN= # Secret runtime injection; never commit or print this value
# STRUCTURE_RESOLVER_CREDENTIAL_REVISION=1 # Bump after credential rotation to reactivate parked structures
# STRUCTURE_RESOLVER_CLIENT_ID= # Dedicated fallback application; otherwise resolver reuses EVE_CLIENT_ID
# STRUCTURE_RESOLVER_CLIENT_SECRET= # Dedicated fallback secret; otherwise resolver reuses EVE_CLIENT_SECRET
# STRUCTURE_RESOLVER_REDIRECT_URI= # Exact registered redirect used only by scripts/structure-resolver-provision.sh
# ESI_HTTP_TIMEOUT_SECS=15            # ESI/Fuzzwork/SSO client timeout
# KILLMAIL_PROCESS_TIMEOUT_SECS=60    # Max time per killmail before skip
# REDISQ_CONNECT_TIMEOUT_SECS=10     # RedisQ TCP connect timeout
# REDISQ_REQUEST_TIMEOUT_SECS=60     # RedisQ per-request timeout
# R2Z2_CONNECT_TIMEOUT_SECS=10       # R2Z2 TCP connect timeout
# R2Z2_REQUEST_TIMEOUT_SECS=15       # R2Z2 per-request timeout
# R2Z2_POLL_INTERVAL_SECS=6          # Min seconds between R2Z2 polls
# R2Z2_MAX_CONSECUTIVE_404S=10       # 404s before resync from sequence.json
# R2Z2_RESYNC_TIMEOUT_SECS=300       # Max seconds in 404 loop before resync
# KILLMAIL_FEED_PROVIDER=redisq      # "redisq" or "r2z2"
# KILLMAIL_WORKERS=4                 # Concurrent processing workers (min 1)
# KILLMAIL_QUEUE_SIZE=512            # Bounded result channel capacity (min 1, max 4096)
# KILLMAIL_POST_PROCESS_SLEEP_MS=0   # Sleep between feed reads (0 for max catch-up speed)
# CONTRACT_DATABASE_PASSWORD=killbot_contracts # Raw PostgreSQL password; set before first Compose startup
# CONTRACT_DATABASE_URL=postgres://killbot_contracts:example%40password@postgres:5432/killbot_contracts # Required whenever Compose password changes; URI-encode reserved password characters
# For a process outside Compose, use 127.0.0.1:5433 instead of postgres:5432 in CONTRACT_DATABASE_URL.
# CONTRACT_COLLECTION_INTERVAL_SECS=300 # Seconds between public-contract collection cycles
# CONTRACT_REGIONAL_CONCURRENCY=2 # Concurrent regional attempts; strict range 1..=4 (set 1 for sequential rollback)
# CONTRACT_PROXIMITY_RECONCILIATION_INTERVAL_SECS=30 # Seconds between retained U reconciliation cycles; strict range 1..=30; no regional public-contract discovery
# SOV_HOME_SYSTEM_ID=30002086 # Reachability origin for the sov timer feed (default Turnur); see README "Sovereignty Timer Feed"
# WANDERER_BASE_URL=https://wanderer.example.com # Wanderer map host; all three WANDERER_* vars required to enable chain reachability
# WANDERER_MAP= # Wanderer map UUID or slug
# WANDERER_MAP_API_KEY= # Map API key: this key is WRITE-CAPABLE on the Wanderer side (systems/connections/signatures); the bot only ever issues GET requests with it and has no write methods on its client type
# HEALTH_EVALUATION_INTERVAL_SECS=60 # Seconds between independent health snapshots
# HEALTH_CHANNEL_ID=1538030920328810536 # Reserved for the Ticket 05 watchdog health view
# WATCHDOG_CONFIG_REVISION=1 # Bump after a Discord token or permission remediation to retry a permanent publication failure
# WATCHDOG_EVALUATION_INTERVAL_SECS=60 # Independent watchdog polling interval (minimum 10 seconds)
# HEALTH_HEARTBEAT_DEGRADED_SECS=300
# HEALTH_HEARTBEAT_CRITICAL_SECS=600
# HEALTH_POSTGRES_DEGRADED_FAILURES=1 # Ticket 05 watchdog evaluates this external outage streak
# HEALTH_POSTGRES_CRITICAL_FAILURES=3 # Bot cannot persist a self-detected PostgreSQL outage
# HEALTH_CONTRACT_PROGRESS_DEGRADED_SECS=900
# HEALTH_CONTRACT_PROGRESS_CRITICAL_SECS=1800
# HEALTH_ESI_PROGRESS_DEGRADED_SECS=900
# HEALTH_ESI_PROGRESS_CRITICAL_SECS=1800
# HEALTH_WATCHLIST_PROGRESS_DEGRADED_SECS=7200
# HEALTH_WATCHLIST_PROGRESS_CRITICAL_SECS=10800
# HEALTH_BACKLOG_DEGRADED_SECS=1800
# HEALTH_BACKLOG_CRITICAL_SECS=7200
# HEALTH_PREPARED_DELIVERY_DEGRADED_SECS=300
# HEALTH_PREPARED_DELIVERY_CRITICAL_SECS=900
# HEALTH_R2Z2_PROGRESS_DEGRADED_SECS=180
# HEALTH_R2Z2_PROGRESS_CRITICAL_SECS=600
# HEALTH_FEED_VALIDATION_DEGRADED_FAILURES=1
# HEALTH_FEED_VALIDATION_CRITICAL_FAILURES=3
# CONTRACT_TEST_DATABASE_URL=postgres://killbot_contracts:killbot_contracts@localhost:5433/killbot_contracts
# CONTRACT_TEST_DISCORD_CHANNEL_ID= # Optional: dedicated channel for the ignored manual contract-embed test
